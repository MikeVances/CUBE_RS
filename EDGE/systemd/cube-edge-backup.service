[Unit]
Description=CUBE EDGE Backup Service
Requires=cube-edge.service

[Service]
Type=oneshot
User=cube_edge
Group=cube_edge
WorkingDirectory=/opt/cube_edge

# Команда для создания резервной копии
ExecStart=/opt/cube_edge/scripts/backup.sh

# Ограничения ресурсов
MemoryLimit=256M
CPUQuota=25%

# Логирование
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cube-edge-backup

# Безопасность
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cube_edge /var/backups/cube_edge

[Install]
WantedBy=multi-user.target