FROM python:3.11-slim

# Установка системных зависимостей
RUN apt-get update && apt-get install -y \
    curl \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Создание пользователя
RUN useradd -m -u 1000 tunnel && \
    mkdir -p /app/data /app/logs && \
    chown -R tunnel:tunnel /app

# Рабочая директория
WORKDIR /app

# Копирование requirements и установка зависимостей
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копирование кода
COPY tunnel_broker.py .
COPY resilient_tunnel_broker.py .
COPY --chown=tunnel:tunnel . .

# Переключение на unprivileged пользователя
USER tunnel

# Порты
EXPOSE 8080 8081

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Команда запуска
CMD ["python3", "resilient_tunnel_broker.py", "--host", "0.0.0.0", "--port", "8080"]