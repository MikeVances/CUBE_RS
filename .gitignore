__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.egg-info/
*$py.class
build/
dist/
*.egg

# === Virtual envs ===
.venv/
venv/
env/

# === IDE ===
.vscode/
.idea/
*.code-workspace
*.swp

